{
  "name": "react-example",
  "private": true,
  "version": "1.9.0",
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"require('fs').mkdirSync('public/assets',{recursive:true});require('fs').copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm','public/assets/sql-wasm.wasm')\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:widget": "esbuild src/widget/snapshot.ts --bundle --format=cjs --platform=node --outfile=.test-build/snapshot.cjs --log-level=error && node src/widget/__tests__/snapshot.test.cjs",
    "verify:android": "python3 scripts/verify-android.py",
    "test:import": "esbuild src/services/bankImport.ts --bundle --format=cjs --platform=node --external:xlsx --outfile=.test-build/bankImport.cjs --log-level=error && node src/services/__tests__/bankImport.test.cjs",
    "test": "npm run test:widget && npm run test:import && npm run test:search",
    "check:java": "bash scripts/check-java.sh",
    "build:demo": "vite build --config vite.demo.config.ts",
    "test:search": "esbuild src/services/marketData.ts --bundle --format=cjs --platform=node --outfile=.test-build/marketData.cjs --log-level=error && node src/services/__tests__/marketData.test.cjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "jeep-sqlite": "^2.8.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "sql.js": "1.12.0",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
