<?xml version="1.0" encoding="utf-8"?>
<!--
  הווידג'ט הקומפקטי (4x2): יתרה והוצאה מול תקציב.

  layoutDirection="locale" — הטקסט בעברית, והפריסה צריכה לזרום מימין
  לשמאל כמו האפליקציה.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:layoutDirection="locale">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_balance_title"
        android:textColor="@color/widgetFaint"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widgetText"
        android:textSize="30sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:textDirection="ltr"
        android:text="@string/widget_no_data" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <TextView
        android:id="@+id/widget_budget_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widgetMuted"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/widgetFaint"
        android:textSize="10sp"
        android:maxLines="1" />

</LinearLayout>
