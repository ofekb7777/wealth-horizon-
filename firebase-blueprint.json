{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "A financial transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "accountId": { "type": "string" }
      },
      "required": ["id", "date", "description", "category", "amount"]
    },
    "Account": {
      "title": "Account",
      "description": "A financial account (bank, investment, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Bank", "Investment", "Pension", "Cash"] },
        "balance": { "type": "number" }
      },
      "required": ["id", "name", "type", "balance"]
    },
    "Investment": {
      "title": "Investment",
      "description": "An investment asset",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticker": { "type": "string" },
        "name": { "type": "string" },
        "shares": { "type": "number" },
        "avgPrice": { "type": "number" },
        "currentPrice": { "type": "number" }
      },
      "required": ["id", "ticker", "shares", "avgPrice", "currentPrice"]
    },
    "Goal": {
      "title": "Goal",
      "description": "A financial goal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "deadline": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "name", "targetAmount", "currentAmount", "category"]
    },
    "Budget": {
      "title": "Budget",
      "description": "A monthly budget limit for a category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "limit": { "type": "number" }
      },
      "required": ["id", "category", "limit"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Global user settings and state",
      "type": "object",
      "properties": {
        "activeSheetId": { "type": "string" },
        "notes": { "type": "string" },
        "patchNotes": { "type": "string" },
        "theme": { "type": "string", "enum": ["default", "amber", "teal", "indigo", "mono"] }
      }
    },
    "SystemUpdate": {
      "title": "System Update",
      "description": "Global broadcast message",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/system_updates/{updateId}": {
      "schema": "SystemUpdate",
      "description": "Global broadcasts for all users"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Main user document"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User's transactions"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": "Account",
      "description": "User's accounts"
    },
    "/users/{userId}/investments/{investmentId}": {
      "schema": "Investment",
      "description": "User's investments"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "Goal",
      "description": "User's goals"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": "Budget",
      "description": "User's budgets"
    }
  }
}
